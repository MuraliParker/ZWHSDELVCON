
<core:FragmentDefinition xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:m="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">
    <ValueHelpDialog title="{i18n>select_customer}" ok=".onValueHelpOkPress" cancel=".onValueHelpCancelPress" supportRanges="true" key="partyno" descriptionKey="name1">
        <filterBar>
            <fb:FilterBar advancedMode="true" search="onCustomerSearch">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem groupName="__$INTERNAL$" name="Customer" label="Customer" visibleInFilterBar="true">
                        <fb:control>
                            <m:Input name="Customer" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem groupName="__$INTERNAL$" name="Name" label="Name" visibleInFilterBar="true">
                        <fb:control>
                            <m:Input name="Name" />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
        </filterBar>
    </ValueHelpDialog>
</core:FragmentDefinition>
